{
  "name": "nd-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "ND-DSH desktop AI company operating system for autonomous software delivery.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "node scripts/verify.mjs && node scripts/verify-nd-pencil.mjs && node scripts/verify-vendor-vscode-git.mjs",
    "release:stage": "node scripts/stage-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "dist:win:dir": "corepack pnpm release:stage && corepack pnpm build && corepack pnpm release:verify && electron-builder --win --dir",
    "dist:win:portable": "corepack pnpm release:stage && corepack pnpm build && corepack pnpm release:verify && electron-builder --win portable",
    "dsh:build": "pnpm --dir vendor/deepseek-harness run build",
    "dsh:update": "node scripts/update-harness.mjs",
    "nd-pencil:build": "node scripts/build-nd-pencil.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "17.2.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.33.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "agent-browser": "0.34.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.8"
  }
}
