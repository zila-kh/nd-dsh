# Optional compatibility credential for the seeded DeepSeek provider.
# Additional providers are configured in ND-DSH Settings and stored securely.
DEEPSEEK_API_KEY=

# Compatibility fallback used only when no ND provider/model selection is
# available. New provider routes are selected from Settings and can use
# provider-native catalog transport or an explicit supported wire protocol.
ND_DSH_PROVIDER=deepseek-official
ND_DSH_MODEL=deepseek-v4-flash
ND_DSH_MAX_TOKENS=49152

# Browser and workspace defaults. The product browser starts blank unless a
# project or operator explicitly chooses a URL.
ND_DSH_BROWSER_URL=about:blank
ND_DSH_CDP_PORT=9222
ND_DSH_WORKSPACE=
ND_DSH_PERMISSION_MODE=workspace-write

# Codex is an optional coding engine backed by the pinned official app-server
# package inside Harness. `never` is the fail-closed unattended mode. Native
# Codex authentication, HOME/CODEX_HOME, model and project configuration remain
# authoritative and are not copied from ND model-provider credentials.
ND_DSH_CODEX_PERMISSION_MODE=never

# Optional path overrides for development or packaged-runtime integration.
# ND_DSH_HARNESS_ROOT=/absolute/path/to/deepseek-harness
# ND_DSH_NODE_BIN=node
# ND_DSH_AGENT_BROWSER_BIN=agent-browser
# ND_DSH_PATCH=/absolute/path/to/overlay.patch.yml
