# Required for real model runs.
DEEPSEEK_API_KEY=

# Current DeepSeek Harness defaults. Override when your account exposes a
# different route/model.
ND_DSH_PROVIDER=deepseek-official
ND_DSH_MODEL=deepseek-v4-flash
ND_DSH_MAX_TOKENS=49152

# Browser and workspace defaults.
ND_DSH_BROWSER_URL=http://localhost:5173
ND_DSH_CDP_PORT=9222
ND_DSH_WORKSPACE=
ND_DSH_PERMISSION_MODE=workspace-write

# Optional path overrides.
# ND_DSH_HARNESS_ROOT=/absolute/path/to/deepseek-harness
# ND_DSH_NODE_BIN=node
# ND_DSH_AGENT_BROWSER_BIN=agent-browser
# ND_DSH_CORDIS_CONFIG=/absolute/path/to/cordis.yml
