# ND-DSH local E2E model matrix
# Copy this file to .env and replace placeholders. .env is gitignored.
#
# All three models share one OpenAI-compatible endpoint and API key.
# Typical base URLs end in /v1.

E2E_MODEL_BASE_URL=https://api.example.com/v1
E2E_MODEL_API_KEY=replace-me

E2E_MODEL_1=model-id-1
E2E_MODEL_2=model-id-2
E2E_MODEL_3=model-id-3

# Optional. Used for the seeded provider model metadata.
E2E_MODEL_CONTEXT=256000

# Optional live beta-driver overrides.
# Windows example:
# BETA_TARGET_WS=C:\\Users\\you\\Documents\\GitHub\\nd-dsh-e2e-models
#
# Backward-compatible profile-copy mode remains available when the E2E_MODEL_*
# variables above are all absent:
# BETA_SOURCE_PROFILE=C:\\Users\\you\\AppData\\Roaming\\nd-dsh
