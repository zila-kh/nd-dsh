{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ND benchmark result",
  "type": "object",
  "required": [
    "schemaVersion",
    "benchmark",
    "timestamp",
    "backend",
    "environment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
